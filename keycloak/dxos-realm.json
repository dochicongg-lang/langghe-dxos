{
  "realm": "dxos",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "editor", "description": "Nhân viên: tạo/sửa dữ liệu ứng dụng; MinIO đọc/ghi mọi bucket NHƯNG KHÔNG ghi/xóa trong iot/" },
      { "name": "readonly", "description": "Chỉ xem; MinIO policy readonly (đọc mọi bucket)" },
      { "name": "admin", "description": "Quản trị: toàn quyền nghiệp vụ, thao tác quy trình" },
      { "name": "producer", "description": "Chủ thể sản xuất (hộ, doanh nghiệp, HTX, nghệ nhân): quản lý sản phẩm của mình" },
      { "name": "coop-officer", "description": "Cán bộ HTX/hội làng nghề: hỗ trợ và sơ duyệt cho thành viên cùng HTX" },
      { "name": "ocop-officer", "description": "Cán bộ đơn vị đầu mối OCOP/hội đồng: xem toàn bộ, ghi kết quả chính thức (giai đoạn sau)" },
      { "name": "iot-writer", "description": "Thiết bị IoT: chỉ ghi (PutObject) vào iot/, không đọc, không gọi API nghiệp vụ" }
    ]
  },
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-dxos-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${KEYCLOAK_CLIENT_ID}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "minio-policy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "policy",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "${KEYCLOAK_IOT_CLIENT_ID}",
      "name": "Thiết bị IoT / gateway xưởng (chỉ ghi dữ liệu cảm biến)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KEYCLOAK_IOT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-dxos-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${KEYCLOAK_CLIENT_ID}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "minio-policy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "policy",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dxos-web",
      "name": "DX-OS Frontend (Next.js, Tầng 2)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audience-dxos-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${KEYCLOAK_CLIENT_ID}",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "minio-policy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "policy",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-${KEYCLOAK_CLIENT_ID}",
      "enabled": true,
      "serviceAccountClientId": "${KEYCLOAK_CLIENT_ID}",
      "realmRoles": []
    },
    {
      "username": "service-account-${KEYCLOAK_IOT_CLIENT_ID}",
      "enabled": true,
      "serviceAccountClientId": "${KEYCLOAK_IOT_CLIENT_ID}",
      "realmRoles": ["iot-writer"]
    },
    {
      "username": "tester",
      "enabled": true,
      "emailVerified": true,
      "email": "tester@dxos.local",
      "firstName": "Test",
      "lastName": "User",
      "realmRoles": ["editor"],
      "credentials": [{ "type": "password", "value": "tester", "temporary": false }]
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "viewer@dxos.local",
      "firstName": "View",
      "lastName": "Only",
      "realmRoles": ["readonly"],
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }]
    }
  ]
}

# Sao chép file này thành .env (docker compose tự đọc .env). Đổi mật khẩu khi triển khai thật.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB=keycloak
FLOWABLE_DB=flowable
POSTGRES_PORT=5432

# MinIO (API chỉ truy cập qua APISIX, không publish cổng 9000)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dxos-data
# Bucket riêng cho số liệu cảm biến IoT, có Object Lock (WORM: ghi một lần, không sửa/xóa trong thời hạn giữ).
# Object Lock chỉ bật được lúc tạo bucket. Chế độ: GOVERNANCE (root còn gỡ được, dùng khi phát triển/thử) hoặc
# COMPLIANCE (kể cả root cũng không phá được, KHÔNG hoàn tác: chỉ dùng khi triển khai thật).
# Số ngày giữ: 1825 (5 năm). Xuất khẩu sang EU thường cần lưu hồ sơ kỹ thuật 10 năm: đặt 3650. Chỉ áp cho tệp ghi sau khi đổi.
IOT_BUCKET=dxos-iot
IOT_LOCK_MODE=GOVERNANCE
# Bắt buộc thêm dòng sau (bỏ dấu #) mới được dùng COMPLIANCE, vì không hoàn tác:
# IOT_LOCK_CONFIRM_COMPLIANCE=yes
IOT_RETENTION_DAYS=1825

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# Flowable (REST, chỉ truy cập nội bộ qua APISIX)
FLOWABLE_ADMIN_USER=rest-admin
FLOWABLE_ADMIN_PASSWORD=change_me_flowable

# APISIX
APISIX_ADMIN_KEY=change_me_apisix_admin_key_32chars
APISIX_VIEWER_KEY=change_me_apisix_viewer_key_32chars
APISIX_GATEWAY_PORT=9080
APISIX_ADMIN_PORT=9180
KEYCLOAK_REALM=dxos
KEYCLOAK_CLIENT_ID=dxos-api
KEYCLOAK_CLIENT_SECRET=change_me_client_secret
FRONTEND_ORIGIN=http://localhost:3000

# Tầng 3: truy xuất nguồn gốc
TRACE_DB=traceability

# trace-api đọc dữ liệu IoT từ MinIO bằng tài khoản CHỈ ĐỌC (tạo bởi scripts/setup-apisix-routes.sh)
TRACE_S3_USER=trace-reader
TRACE_S3_PASSWORD=change_me_trace_reader_pw

# Tệp đính kèm hồ sơ OCOP: bucket riêng + tài khoản MinIO riêng cho trace-api (tạo bởi scripts/setup-apisix-routes.sh).
# Cổng gác chặn bucket này với mọi người dùng cuối; tệp chỉ lấy ra được qua trace-api sau khi kiểm quyền xem hồ sơ.
DOCS_BUCKET=dxos-docs
TRACE_DOCS_USER=trace-docs
TRACE_DOCS_PASSWORD=change_me_trace_docs_pw

# Thiết bị IoT (gateway xưởng) có client Keycloak riêng, chỉ có role iot-writer (chỉ ghi vào iot/)
KEYCLOAK_IOT_CLIENT_ID=dxos-iot
KEYCLOAK_IOT_CLIENT_SECRET=change_me_iot_client_secret

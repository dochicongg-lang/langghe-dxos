# Sao chép file này thành .env (docker compose tự đọc .env). Đổi mật khẩu khi triển khai thật.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB=keycloak
FLOWABLE_DB=flowable
POSTGRES_PORT=5432

# MinIO (API chỉ truy cập qua APISIX, không publish cổng 9000)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dxos-data

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# Flowable (REST, chỉ truy cập nội bộ qua APISIX)
FLOWABLE_ADMIN_USER=rest-admin
FLOWABLE_ADMIN_PASSWORD=change_me_flowable

# APISIX
APISIX_ADMIN_KEY=change_me_apisix_admin_key_32chars
APISIX_VIEWER_KEY=change_me_apisix_viewer_key_32chars
APISIX_GATEWAY_PORT=9080
APISIX_ADMIN_PORT=9180
KEYCLOAK_REALM=dxos
KEYCLOAK_CLIENT_ID=dxos-api
KEYCLOAK_CLIENT_SECRET=change_me_client_secret
FRONTEND_ORIGIN=http://localhost:3000

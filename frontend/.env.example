# Sao chép thành .env.local nếu cần đổi (mặc định đã khớp docker-compose ở thư mục gốc).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=dxos
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=dxos-web
NEXT_PUBLIC_API_BASE_URL=http://localhost:9080
NEXT_PUBLIC_S3_ENDPOINT=http://s3.localhost:9080
NEXT_PUBLIC_IOT_BUCKET=dxos-iot

# Kênh liên hệ hỗ trợ hiển thị cho người dùng (để trống kênh nào thì kênh đó không hiện)
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_ZALO=
NEXT_PUBLIC_SUPPORT_FACEBOOK=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=
